{
  "name": "pokemonteamthing",
  "version": "1.0.0",
  "private": true,
  "description": "Development scripts for the Pokemon VGC team builder monorepo",
  "scripts": {
    "dev:docker": "docker compose up",
    "dev:docker:build": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "health": "curl -s http://localhost:5050/api/health",
    "build": "npm run build --prefix frontend"
  }
}
